# Copy this file to .env and replace the placeholder secrets.
# pydantic-settings reads these names. Do not commit a real .env file.

APP_NAME=DocuCrew
APP_ENV=development
DEBUG=true

# Async SQLAlchemy URL. The API and Alembic both use this variable.
# The engine always connects with ssl=require, which matches hosted Postgres such as Neon.
DATABASE_URL=postgresql+asyncpg://user:password@host/docucrew?ssl=require

# JWT signing. Login stores the token in an httpOnly cookie named access_token.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# bcrypt cost. When unset, the application defaults to 12.
SALT_ROUNDS=12

# Used by the CrewAI agents. OPENAI_MODEL is the chat model passed to each agent.
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# Declared on Settings. The Chroma service does not read this; ChromaDB embeds
# chunks with its own default embedding function when documents are added.
EMBEDDING_MODEL=text-embedding-3-small

# Local Chroma persistence directory. Created on startup. Gitignored.
CHROMA_PERSIST_DIR=./chroma_data

# Browser origins allowed to send the auth cookie. Must be a JSON list.
ALLOWED_ORIGINS=["http://localhost:3000"]

# Declared on Settings. Logout only clears the cookie; Redis is not used yet.
REDIS_URL=redis://localhost:6379

# Required at import time. Query agents construct TavilySearchTool while the app loads.
TAVILY_API_KEY=tvly-your-key
